sub-binarization-binarization-pro-debug:
	@if not exist binarization\ mkdir binarization\ & if not exist binarization\ exit 1
	@set MAKEFLAGS=$(MAKEFLAGS)
	cd binarization\ && ( if not exist Makefile $(QMAKE) -o Makefile D:\Qt\project\opencv\plugins\binarization\binarization.pro -spec win32-msvc "CONFIG+=debug" "CONFIG+=qml_debug" ) && $(MAKE) -f Makefile debug
