sub-blocksdk-blocksdk-pro-debug_ordered:
	@if not exist blocksdk\ mkdir blocksdk\ & if not exist blocksdk\ exit 1
	@set MAKEFLAGS=$(MAKEFLAGS)
	cd blocksdk\ && ( if not exist Makefile $(QMAKE) -o Makefile D:\Qt\project\opencv\blocksdk\blocksdk.pro -spec win32-msvc "CONFIG+=release" ) && $(MAKE) -f Makefile debug
sub-plugins-plugins-pro-debug_ordered: sub-blocksdk-blocksdk-pro-debug_ordered 
	@if not exist plugins\ mkdir plugins\ & if not exist plugins\ exit 1
	@set MAKEFLAGS=$(MAKEFLAGS)
	cd plugins\ && ( if not exist Makefile $(QMAKE) -o Makefile D:\Qt\project\opencv\plugins\plugins.pro -spec win32-msvc "CONFIG+=release" ) && $(MAKE) -f Makefile debug
sub-opencv_app-pro-debug_ordered: sub-plugins-plugins-pro-debug_ordered 
	@set MAKEFLAGS=$(MAKEFLAGS)
	( if not exist Makefile.opencv_app $(QMAKE) -o Makefile.opencv_app D:\Qt\project\opencv\opencv_app.pro -spec win32-msvc "CONFIG+=release" ) && $(MAKE) -f Makefile.opencv_app debug
debug: sub-blocksdk-blocksdk-pro-debug_ordered sub-plugins-plugins-pro-debug_ordered sub-opencv_app-pro-debug_ordered

