qmake: FORCE
	@$(QMAKE) -o Makefile ..\opencv.pro -spec win32-msvc "CONFIG+=release"

qmake_all: sub-blocksdk-blocksdk-pro-qmake_all sub-plugins-plugins-pro-qmake_all sub-opencv_app-pro-qmake_all FORCE

make_first: sub-blocksdk-blocksdk-pro-make_first-ordered sub-plugins-plugins-pro-make_first-ordered sub-opencv_app-pro-make_first-ordered  FORCE
all: sub-blocksdk-blocksdk-pro-all-ordered sub-plugins-plugins-pro-all-ordered sub-opencv_app-pro-all-ordered  FORCE
clean: sub-blocksdk-blocksdk-pro-clean-ordered sub-plugins-plugins-pro-clean-ordered sub-opencv_app-pro-clean-ordered  FORCE
distclean: sub-blocksdk-blocksdk-pro-distclean-ordered sub-plugins-plugins-pro-distclean-ordered sub-opencv_app-pro-distclean-ordered  FORCE
	-$(DEL_FILE) Makefile
	-$(DEL_FILE) .qmake.stash
