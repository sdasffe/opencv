plugin_demo.pro:
qmake: FORCE
	@$(QMAKE) -o Makefile plugin_demo.pro -spec win32-msvc "CONFIG+=release\ "

qmake_all: sub-core-qmake_all sub-blur_plugin-qmake_all sub-host-qmake_all FORCE

make_first: sub-core-make_first sub-blur_plugin-make_first sub-host-make_first  FORCE
all: sub-core-all sub-blur_plugin-all sub-host-all  FORCE
clean: sub-core-clean sub-blur_plugin-clean sub-host-clean  FORCE
distclean: sub-core-distclean sub-blur_plugin-distclean sub-host-distclean  FORCE
	-$(DEL_FILE) Makefile
	-$(DEL_FILE) .qmake.stash
install_subtargets: sub-core-install_subtargets sub-blur_plugin-install_subtargets sub-host-install_subtargets FORCE
uninstall_subtargets: sub-core-uninstall_subtargets sub-blur_plugin-uninstall_subtargets sub-host-uninstall_subtargets FORCE

sub-core-debug:
	@if not exist core\ mkdir core\ & if not exist core\ exit 1
	@set MAKEFLAGS=$(MAKEFLAGS)
	cd core\ && ( if not exist Makefile $(QMAKE) -o Makefile D:\Qt\project\opencv\plugin_demo\core\core.pro -spec win32-msvc "CONFIG+=release\ " ) && $(MAKE) -f Makefile debug
sub-blur_plugin-debug: sub-core-debug
	@if not exist blur_plugin\ mkdir blur_plugin\ & if not exist blur_plugin\ exit 1
	@set MAKEFLAGS=$(MAKEFLAGS)
	cd blur_plugin\ && ( if not exist Makefile $(QMAKE) -o Makefile D:\Qt\project\opencv\plugin_demo\blur_plugin\blur_plugin.pro -spec win32-msvc "CONFIG+=release\ " ) && $(MAKE) -f Makefile debug
sub-host-debug: sub-core-debug
	@if not exist host\ mkdir host\ & if not exist host\ exit 1
	@set MAKEFLAGS=$(MAKEFLAGS)
	cd host\ && ( if not exist Makefile $(QMAKE) -o Makefile D:\Qt\project\opencv\plugin_demo\host\host.pro -spec win32-msvc "CONFIG+=release\ " ) && $(MAKE) -f Makefile debug
debug: sub-core-debug sub-blur_plugin-debug sub-host-debug

sub-core-release:
	@if not exist core\ mkdir core\ & if not exist core\ exit 1
	@set MAKEFLAGS=$(MAKEFLAGS)
	cd core\ && ( if not exist Makefile $(QMAKE) -o Makefile D:\Qt\project\opencv\plugin_demo\core\core.pro -spec win32-msvc "CONFIG+=release\ " ) && $(MAKE) -f Makefile release
sub-blur_plugin-release: sub-core-release
