	@set MAKEFLAGS=$(MAKEFLAGS)
	cd core\ && ( if not exist Makefile $(QMAKE) -o Makefile D:\Qt\project\opencv\plugin_demo\core\core.pro -spec win32-msvc "CONFIG+=release\ " ) && $(MAKE) -f Makefile check
