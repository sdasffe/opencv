	@set MAKEFLAGS=$(MAKEFLAGS)
	cd blur_plugin\ && ( if not exist Makefile $(QMAKE) -o Makefile D:\Qt\project\opencv\plugin_demo\blur_plugin\blur_plugin.pro -spec win32-msvc "CONFIG+=release\ " ) && $(MAKE) -f Makefile release
sub-host-release: sub-core-release
	@if not exist host\ mkdir host\ & if not exist host\ exit 1
	@set MAKEFLAGS=$(MAKEFLAGS)
	cd host\ && ( if not exist Makefile $(QMAKE) -o Makefile D:\Qt\project\opencv\plugin_demo\host\host.pro -spec win32-msvc "CONFIG+=release\ " ) && $(MAKE) -f Makefile release
release: sub-core-release sub-blur_plugin-release sub-host-release

