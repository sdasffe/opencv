	@if not exist core\ mkdir core\ & if not exist core\ exit 1
	@set MAKEFLAGS=$(MAKEFLAGS)
	cd core\ && ( if not exist Makefile $(QMAKE) -o Makefile D:\Qt\project\opencv\plugin_demo\core\core.pro -spec win32-msvc "CONFIG+=release\ " ) && $(MAKE) -f Makefile benchmark
sub-blur_plugin-benchmark: sub-core-benchmark
	@if not exist blur_plugin\ mkdir blur_plugin\ & if not exist blur_plugin\ exit 1
	@set MAKEFLAGS=$(MAKEFLAGS)
	cd blur_plugin\ && ( if not exist Makefile $(QMAKE) -o Makefile D:\Qt\project\opencv\plugin_demo\blur_plugin\blur_plugin.pro -spec win32-msvc "CONFIG+=release\ " ) && $(MAKE) -f Makefile benchmark
sub-host-benchmark: sub-core-benchmark
	@if not exist host\ mkdir host\ & if not exist host\ exit 1
	@set MAKEFLAGS=$(MAKEFLAGS)
	cd host\ && ( if not exist Makefile $(QMAKE) -o Makefile D:\Qt\project\opencv\plugin_demo\host\host.pro -spec win32-msvc "CONFIG+=release\ " ) && $(MAKE) -f Makefile benchmark
benchmark: sub-core-benchmark sub-blur_plugin-benchmark sub-host-benchmark
install:install_subtargets  FORCE

uninstall: uninstall_subtargets FORCE

